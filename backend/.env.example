# Copy to .env and fill in real values. .env is gitignored — never commit it.
# Note: docker-compose.yaml overrides DATABASE_URL to point at the local `db`
# service, so the value here only matters for commands run outside Docker.

DATABASE_URL=postgresql://user:password@host/dbname  # Neon prod URL (pooled/pgbouncer endpoint)
GOOGLE_API_KEY=your-google-api-key                    # Used for geocoding addresses
OPENAI_API_KEY=your-openai-api-key                    # Used for contact embeddings (semantic search)
S3_BUCKET_NAME=your-s3-bucket-name                    # Bucket for contact profile pictures
AWS_ACCESS_KEY_ID=your-aws-access-key-id              # For local S3 presigning (prod uses the Lambda role instead)
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key      # For local S3 presigning (prod uses the Lambda role instead)
