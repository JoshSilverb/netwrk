# Copy this file to .env.local (already gitignored via .env*.local) to set these
# persistently for your local checkout, instead of passing them inline per command.

# Which backend to hit: 'local' or 'prod'. If unset, defaults to 'local' in
# dev builds (__DEV__) and 'prod' otherwise (so release / EAS builds hit prod
# unless this is explicitly set to 'local'). Any other value is treated as
# unset (with a console warning) and falls back to that same default.
#   local -> http://<dev-machine-host>:8000
#   prod  -> https://api.mynetwrk.com
# EXPO_PUBLIC_API_TARGET=local

# Explicit backend URL override. If set, this is used verbatim and takes
# precedence over EXPO_PUBLIC_API_TARGET.
# EXPO_PUBLIC_API_URL=http://localhost:8000

# Note: `expo start --tunnel` gives a public *.exp.direct hostUri that can't
# reach your local backend on :8000. In tunnel mode, set EXPO_PUBLIC_API_URL
# explicitly (e.g. to an ngrok URL), or use LAN mode instead.
